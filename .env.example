# ==============================================================
# SMTP Mail Configuration (Nodemailer)
# ==============================================================
# Configure Gmail SMTP with Google App Password (not your regular account password)
# 1. Enable 2-Step Verification in Google Account
# 2. Generate a 16-character App Password under Security -> App Passwords
# ==============================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-school-email@gmail.com
SMTP_PASS=your-16-char-app-password
CONTACT_TO_EMAIL=kidsfoundationghari@gmail.com

# ==============================================================
# Strapi CMS Configuration
# ==============================================================
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337
STRAPI_API_TOKEN=
